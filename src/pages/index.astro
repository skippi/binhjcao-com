---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { bio, formatDate, projects, socials } from "../content";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base>
  <main class="site-shell">
    <article class="content-frame">
      <div class="home-layout">
        <div class="home-copy">
          <h1 class="site-title">
            <a class="site-title-link" href="https://x.com/binhjcao" target="_blank" rel="noopener noreferrer">
              <span class="site-title-at">@</span>binhjcao
            </a>
          </h1>
          <section class="bio-section" aria-label="Biography" data-bio-root>
            <div class="bio-toggle">
              <span>Bio</span>
              <div class="bio-toggle-options" role="group" aria-label="Bio length">
                <button type="button" data-bio="default" aria-pressed="true" aria-controls="bio-content">
                  <span>Default</span>
                </button>
                <button type="button" data-bio="long" aria-pressed="false" aria-controls="bio-content">
                  <span>Long</span>
                </button>
              </div>
            </div>
            <div id="bio-content">
              <div data-bio-panel="default">
                {bio.default.map((html) => <p class="content-paragraph" set:html={html} />)}
              </div>
              <div data-bio-panel="long" hidden>
                {bio.long.map((html) => <p class="content-paragraph" set:html={html} />)}
              </div>
            </div>
            <nav class="socials" aria-label="Socials">
              <ul class="social-list">
                {
                  socials.map((social) => (
                    <li>
                      <a
                        class="social-link"
                        href={social.href}
                        {...(social.href.startsWith("http")
                          ? { target: "_blank", rel: "noopener noreferrer" }
                          : {})}
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          {social.name === "GitHub" && (
                            <path
                              fill="currentColor"
                              d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
                            />
                          )}
                          {social.name === "Twitter" && (
                            <path
                              fill="currentColor"
                              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                            />
                          )}
                          {social.name === "Discord" && (
                            <path
                              fill="currentColor"
                              d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
                            />
                          )}
                          {social.name === "Email" && (
                            <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
                              <rect x="1.5" y="3" width="21" height="18" rx="2" />
                              <path d="M2.2 6.1 12 13.2 21.8 6.1" />
                            </g>
                          )}
                        </svg>
                        <span class="social-label">{social.name}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </section>
          <div class="writing-index">
            <section aria-labelledby="projects-heading">
              <h2 id="projects-heading">Projects</h2>
              <ul class="projects-list">
                {
                  projects.map((project) => (
                    <li>
                      <a href={project.href}>{project.name}</a>
                    </li>
                  ))
                }
              </ul>
            </section>
            <section aria-labelledby="blogs-heading">
              <h2 id="blogs-heading">Blogs</h2>
              <div class="blogs-list">
                {
                  posts.map((post) => (
                    <a class="blog-row" href={`/${post.id}`}>
                      <span>{post.data.title}</span>
                      <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
                    </a>
                  ))
                }
              </div>
            </section>
          </div>
        </div>
        <aside class="home-visual">
          <div class="home-art">
            <img class="home-city" src="/cityscape.svg" alt="A pastel cityscape at night" />
            <svg class="home-sky" aria-hidden="true">
              <g class="home-sky-lights"></g>
            </svg>
          </div>
        </aside>
      </div>
    </article>
  </main>
</Base>

<script>
  const root = document.querySelector("[data-bio-root]");
  if (root) {
    const buttons = root.querySelectorAll("[data-bio]");
    const panels = root.querySelectorAll("[data-bio-panel]");
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const key = button.getAttribute("data-bio");
        buttons.forEach((item) => {
          item.setAttribute("aria-pressed", String(item === button));
        });
        panels.forEach((panel) => {
          panel.toggleAttribute("hidden", panel.getAttribute("data-bio-panel") !== key);
        });
      });
    });
  }

  const panel = document.querySelector(".home-visual");
  const art = document.querySelector(".home-art");
  const sky = document.querySelector(".home-sky");
  const lights = document.querySelector(".home-sky-lights");
  if (panel instanceof HTMLElement && art instanceof HTMLElement && sky instanceof SVGSVGElement && lights) {
    const NS = "http://www.w3.org/2000/svg";
    const sceneW = 1382;
    const sceneH = (sceneW * 31) / 17;
    const pageSeed = Math.floor(Math.random() * 1e9);
    const city = document.querySelector(".home-city");
    const samples = 346;
    const roofY = Array(samples).fill(1262);
    const readSkyline = () => {
      if (!(city instanceof HTMLImageElement) || !city.naturalWidth) return;
      const canvas = document.createElement("canvas");
      canvas.width = samples;
      canvas.height = 512;
      const ctx = canvas.getContext("2d", { willReadFrequently: true });
      if (!ctx) return;
      ctx.drawImage(city, 0, 0, samples, 512);
      const data = ctx.getImageData(0, 0, samples, 512).data;
      const skyR = data[0];
      const skyG = data[1];
      const skyB = data[2];
      for (let x = 0; x < samples; x++) {
        let y = 0;
        for (; y < 512; y++) {
          const i = (y * samples + x) * 4;
          if (Math.abs(data[i] - skyR) + Math.abs(data[i + 1] - skyG) + Math.abs(data[i + 2] - skyB) > 28) break;
        }
        roofY[x] = (y / 512) * 2048;
      }
    };
    const roofFromBottomAt = (x: number) => {
      const i = Math.min(samples - 1, Math.max(0, Math.round((x / sceneW) * (samples - 1))));
      let top = 2048 - roofY[i];
      for (let k = i - 1; k <= i + 1; k++) {
        if (k < 0 || k >= samples) continue;
        top = Math.max(top, 2048 - roofY[k]);
      }
      return top;
    };
    sky.setAttribute("viewBox", "0 0 " + sceneW + " " + sceneH);
    lights.setAttribute("id", "home-sky-stars");
    const add = (tag: string, attrs: Record<string, string | number>) => {
      const node = document.createElementNS(NS, tag);
      for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, String(value));
      lights.appendChild(node);
      return node;
    };
    const layout = () => {
      const panelW = panel.clientWidth;
      const panelH = panel.clientHeight;
      if (panelW < 2 || panelH < 2) return;
      const aspect = panelW / panelH;
      const canon = 17 / 31;
      const viewW = aspect >= canon ? sceneW : sceneH * aspect;
      const viewH = aspect >= canon ? sceneW / aspect : sceneH;
      const scale = panelW / viewW;
      const inset = 12 / scale;
      const visLeft = (sceneW - viewW) / 2;
      art.style.width = sceneW * scale + "px";
      art.style.height = sceneH * scale + "px";
      lights.replaceChildren();
      let seed = pageSeed;
      const rand = () => {
        seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
        return seed / 4294967296;
      };
      readSkyline();
      const ceil = sceneH - 18;
      const count = 112;
      const placed: { x: number; y: number; r: number }[] = [];
      let tries = 0;
      while (placed.length < count && tries < count * 16) {
        tries++;
        const x = 8 + rand() * (sceneW - 16);
        const floor = roofFromBottomAt(x) + 22;
        const roll = rand();
        const radius = roll < 0.1 ? 8 + rand() * 6 : 2.5 + rand() * 2.5;
        const twinkle = rand();
        const fromBottom = floor + rand() * Math.max(12, ceil - floor);
        const y = sceneH - fromBottom;
        let crowded = false;
        for (const other of placed) {
          let dx = Math.abs(x - other.x);
          if (dx > sceneW / 2) dx = sceneW - dx;
          const dy = y - other.y;
          const need = Math.max(32, radius + other.r + 14);
          if (dx * dx + dy * dy < need * need) {
            crowded = true;
            break;
          }
        }
        if (crowded) continue;
        placed.push({ x, y, r: radius });
        if (fromBottom + radius > viewH - inset) continue;
        if (x - radius < visLeft + inset || x + radius > visLeft + viewW - inset) continue;
        const node =
          roll < 0.1
            ? add("polygon", {
                points: Array.from({ length: 8 }, (_, j) => {
                  const angle = -Math.PI / 2 + (j * Math.PI) / 4;
                  const arm = j % 2 ? radius * 0.34 : radius;
                  return (x + Math.cos(angle) * arm).toFixed(1) + "," + (y + Math.sin(angle) * arm).toFixed(1);
                }).join(" "),
                fill: "#fce8e1",
              })
            : add("circle", { cx: x.toFixed(1), cy: y.toFixed(1), r: radius.toFixed(2), fill: "#fce8e1" });
        if (twinkle < 0.72) {
          node.setAttribute("class", "home-star-twinkle");
          node.style.animationDuration = (1.15 + twinkle * 1.7).toFixed(2) + "s";
          node.style.animationDelay = (twinkle * 1.8).toFixed(2) + "s";
        }
      }
    };
    const defs = document.createElementNS(NS, "defs");
    const grad = document.createElementNS(NS, "linearGradient");
    grad.setAttribute("id", "home-meteor");
    grad.setAttribute("gradientUnits", "userSpaceOnUse");
    const tailStop = document.createElementNS(NS, "stop");
    tailStop.setAttribute("offset", "0");
    tailStop.setAttribute("stop-color", "#fce8e1");
    tailStop.setAttribute("stop-opacity", "0");
    const headStop = document.createElementNS(NS, "stop");
    headStop.setAttribute("offset", "1");
    headStop.setAttribute("stop-color", "#fce8e1");
    headStop.setAttribute("stop-opacity", "0.85");
    grad.append(tailStop, headStop);
    defs.append(grad);
    sky.prepend(defs);
    const meteor = document.createElementNS(NS, "line");
    meteor.setAttribute("stroke", "url(#home-meteor)");
    meteor.setAttribute("stroke-linecap", "round");
    meteor.setAttribute("stroke-width", "10");
    meteor.setAttribute("opacity", "0");
    sky.append(meteor);
    let hovering = false;
    let meteorTimer = 0;
    let meteorFrame = 0;
    let meteorFromRight = Math.random() < 0.5;
    let meteorDue = 1400;
    let meteorDueAt = 0;
    let meteorElapsed = 0;
    let meteorRun: {
      x0: number;
      y0: number;
      x1: number;
      y1: number;
      dist: number;
      duration: number;
      trail: number;
      resumedAt: number;
    } | null = null;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const launchMeteor = () => {
      const panelW = panel.clientWidth;
      const panelH = panel.clientHeight;
      if (panelW < 2 || panelH < 2) return;
      const aspect = panelW / panelH;
      const viewW = aspect >= 17 / 31 ? sceneW : sceneH * aspect;
      const viewH = aspect >= 17 / 31 ? sceneW / aspect : sceneH;
      const visLeft = (sceneW - viewW) / 2;
      const skyTop = sceneH - viewH + 36;
      const skyBottom = Math.min(skyTop + viewH * 0.42, sceneH - 900);
      if (skyBottom <= skyTop + 30) return;
      const y0 = skyTop + Math.random() * (skyBottom - skyTop);
      const fromRight = meteorFromRight;
      meteorFromRight = !meteorFromRight;
      const travel = viewW * 0.62;
      const drop = viewH * (0.045 + Math.random() * 0.04);
      const x0 = fromRight ? visLeft + viewW + 30 : visLeft - 30;
      const x1 = fromRight ? x0 - travel : x0 + travel;
      const y1 = y0 + drop;
      const dist = Math.hypot(x1 - x0, y1 - y0) || 1;
      meteorElapsed = 0;
      meteorRun = { x0, y0, x1, y1, dist, duration: 4600, trail: 270, resumedAt: performance.now() };
      window.cancelAnimationFrame(meteorFrame);
      meteorFrame = window.requestAnimationFrame(stepMeteor);
    };
    const stepMeteor = (now: number) => {
      if (!hovering || !meteorRun) {
        meteorFrame = 0;
        return;
      }
      const p = (meteorElapsed + (now - meteorRun.resumedAt)) / meteorRun.duration;
      if (p >= 1) {
        meteor.setAttribute("opacity", "0");
        meteorRun = null;
        meteorElapsed = 0;
        meteorFrame = 0;
        return;
      }
      const head = p < 0.15 ? p / 0.15 : p > 0.78 ? (1 - p) / 0.22 : 1;
      const hx = meteorRun.x0 + (meteorRun.x1 - meteorRun.x0) * p;
      const hy = meteorRun.y0 + (meteorRun.y1 - meteorRun.y0) * p;
      const along = Math.min(meteorRun.trail, p * meteorRun.dist);
      const tx = hx - ((meteorRun.x1 - meteorRun.x0) / meteorRun.dist) * along;
      const ty = hy - ((meteorRun.y1 - meteorRun.y0) / meteorRun.dist) * along;
      grad.setAttribute("x1", tx.toFixed(1));
      grad.setAttribute("y1", ty.toFixed(1));
      grad.setAttribute("x2", hx.toFixed(1));
      grad.setAttribute("y2", hy.toFixed(1));
      meteor.setAttribute("x1", tx.toFixed(1));
      meteor.setAttribute("y1", ty.toFixed(1));
      meteor.setAttribute("x2", hx.toFixed(1));
      meteor.setAttribute("y2", hy.toFixed(1));
      meteor.setAttribute("opacity", Math.max(0, 0.62 * head).toFixed(3));
      meteorFrame = window.requestAnimationFrame(stepMeteor);
    };
    const queueMeteor = (delay: number) => {
      window.clearTimeout(meteorTimer);
      meteorDue = delay;
      meteorDueAt = performance.now();
      meteorTimer = window.setTimeout(() => {
        meteorTimer = 0;
        if (!hovering) return;
        launchMeteor();
        queueMeteor(6000);
      }, delay);
    };
    const pauseSky = () => {
      if (meteorRun && meteorRun.resumedAt) {
        meteorElapsed += performance.now() - meteorRun.resumedAt;
        meteorRun.resumedAt = 0;
      }
      window.cancelAnimationFrame(meteorFrame);
      meteorFrame = 0;
      if (meteorTimer) {
        meteorDue = Math.max(0, meteorDue - (performance.now() - meteorDueAt));
        window.clearTimeout(meteorTimer);
        meteorTimer = 0;
      }
    };
    if (!reducedMotion) {
      panel.addEventListener("pointerenter", () => {
        hovering = true;
        if (meteorRun) {
          meteorRun.resumedAt = performance.now();
          if (!meteorFrame) meteorFrame = window.requestAnimationFrame(stepMeteor);
        }
        if (!meteorTimer) queueMeteor(meteorDue);
      });
      panel.addEventListener("pointerleave", () => {
        hovering = false;
        pauseSky();
      });
    }
    if (city instanceof HTMLImageElement && !city.complete) city.addEventListener("load", layout, { once: true });
    layout();
    new ResizeObserver(layout).observe(panel);
  }

</script>
