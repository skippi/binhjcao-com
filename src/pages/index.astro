---
import Base from "../layouts/Base.astro";
import { bio, formatDate, posts, projects } from "../content";
---

<Base>
  <main class="site-shell">
    <article class="content-frame">
      <div class="home-layout">
        <div class="home-copy">
          <h1 class="site-title">
            <a class="site-title-link" href="https://x.com/binhjcao" target="_blank" rel="noopener noreferrer">
              <span class="site-title-at">@</span>binhjcao
            </a>
          </h1>
          <section class="bio-section" aria-label="Biography" data-bio-root>
            <div class="bio-toggle">
              <span>Bio</span>
              <div class="bio-toggle-options" role="group" aria-label="Bio length">
                <button type="button" data-bio="default" aria-pressed="true" aria-controls="bio-content">
                  Default
                </button>
                <button type="button" data-bio="long" aria-pressed="false" aria-controls="bio-content">
                  Long
                </button>
              </div>
            </div>
            <div id="bio-content">
              <div data-bio-panel="default">
                {bio.default.map((html) => <p class="content-paragraph" set:html={html} />)}
              </div>
              <div data-bio-panel="long" hidden>
                {bio.long.map((html) => <p class="content-paragraph" set:html={html} />)}
              </div>
            </div>
          </section>
          <div class="writing-index">
            <section aria-labelledby="projects-heading">
              <h2 id="projects-heading">Projects</h2>
              <ul class="projects-list">
                {
                  projects.map((project) => (
                    <li>
                      <a href={project.href}>{project.name}</a>
                    </li>
                  ))
                }
              </ul>
            </section>
            <section aria-labelledby="blogs-heading">
              <h2 id="blogs-heading">Blogs</h2>
              <div class="blogs-list">
                {
                  posts.map((post) => (
                    <a class="blog-row" href={`/${post.slug}`}>
                      <span>{post.title}</span>
                      <time datetime={post.date}>{formatDate(post.date!)}</time>
                    </a>
                  ))
                }
              </div>
            </section>
          </div>
        </div>
        <aside class="home-visual">
          <div
            class="home-painting"
            role="img"
            aria-label="A painted waterfront city above green fields at dusk"
          >
            <svg viewBox="0 0 816 1488" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <defs>
                <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#1a4068"></stop>
                  <stop offset="0.28" stop-color="#3e7eaa"></stop>
                  <stop offset="0.52" stop-color="#e39a62"></stop>
                  <stop offset="0.7" stop-color="#f4c98a"></stop>
                  <stop offset="0.86" stop-color="#f6e2c4"></stop>
                </linearGradient>
                <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#d98a62"></stop>
                  <stop offset="0.35" stop-color="#4f86a4"></stop>
                  <stop offset="1" stop-color="#2c5c78"></stop>
                </linearGradient>
                <linearGradient id="field" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#6d8f46"></stop>
                  <stop offset="1" stop-color="#3e6a38"></stop>
                </linearGradient>
                <filter id="grain" x="0" y="0" width="100%" height="100%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch"></feTurbulence>
                  <feColorMatrix type="saturate" values="0"></feColorMatrix>
                  <feComponentTransfer>
                    <feFuncA type="linear" slope="0.28"></feFuncA>
                  </feComponentTransfer>
                </filter>
              </defs>
              <rect width="816" height="1488" fill="url(#sky)"></rect>
              <ellipse cx="180" cy="150" rx="150" ry="36" fill="#f7fbff" opacity="0.18"></ellipse>
              <ellipse cx="560" cy="210" rx="180" ry="42" fill="#fff6ea" opacity="0.2"></ellipse>
              <ellipse cx="390" cy="90" rx="120" ry="28" fill="#ffffff" opacity="0.12"></ellipse>
              <circle cx="628" cy="300" r="150" fill="#f6c48a" opacity="0.35"></circle>
              <circle cx="628" cy="300" r="58" fill="#fff1d4"></circle>
              <path d="M-20 690C120 600 210 640 340 560C470 480 560 590 700 520C760 490 800 530 840 548V760H-20Z" fill="#2a4654"></path>
              <path d="M-20 730C140 670 250 710 390 650C520 596 610 680 840 640V790H-20Z" fill="#1d3944"></path>
              <g fill="#163844">
                <rect x="48" y="548" width="42" height="242"></rect>
                <rect x="96" y="500" width="28" height="290"></rect>
                <rect x="132" y="590" width="70" height="200"></rect>
                <rect x="214" y="520" width="36" height="270"></rect>
                <rect x="258" y="470" width="22" height="320"></rect>
                <rect x="292" y="560" width="84" height="230"></rect>
                <rect x="390" y="500" width="40" height="290"></rect>
                <rect x="438" y="430" width="24" height="360"></rect>
                <rect x="472" y="545" width="76" height="245"></rect>
                <rect x="560" y="490" width="34" height="300"></rect>
                <rect x="604" y="575" width="90" height="215"></rect>
                <rect x="706" y="530" width="48" height="260"></rect>
                <rect x="762" y="590" width="54" height="200"></rect>
              </g>
              <g fill="#c46b4a">
                <rect x="132" y="590" width="70" height="16"></rect>
                <rect x="292" y="560" width="84" height="14"></rect>
                <rect x="472" y="545" width="76" height="18"></rect>
                <rect x="604" y="575" width="90" height="14"></rect>
              </g>
              <g fill="#e7d3b0">
                <rect x="214" y="520" width="36" height="12"></rect>
                <rect x="390" y="500" width="40" height="12"></rect>
                <rect x="560" y="490" width="34" height="10"></rect>
                <rect x="706" y="530" width="48" height="12"></rect>
              </g>
              <g fill="#f6e0b0" opacity="0.9">
                <rect x="58" y="570" width="7" height="9"></rect>
                <rect x="74" y="570" width="7" height="9"></rect>
                <rect x="58" y="596" width="7" height="9"></rect>
                <rect x="74" y="622" width="7" height="9"></rect>
                <rect x="148" y="628" width="8" height="10"></rect>
                <rect x="168" y="628" width="8" height="10"></rect>
                <rect x="148" y="656" width="8" height="10"></rect>
                <rect x="178" y="684" width="8" height="10"></rect>
                <rect x="224" y="560" width="6" height="8"></rect>
                <rect x="236" y="590" width="6" height="8"></rect>
                <rect x="224" y="640" width="6" height="8"></rect>
                <rect x="308" y="600" width="8" height="10"></rect>
                <rect x="328" y="600" width="8" height="10"></rect>
                <rect x="348" y="628" width="8" height="10"></rect>
                <rect x="308" y="656" width="8" height="10"></rect>
                <rect x="402" y="540" width="6" height="8"></rect>
                <rect x="414" y="570" width="6" height="8"></rect>
                <rect x="402" y="620" width="6" height="8"></rect>
                <rect x="488" y="590" width="8" height="10"></rect>
                <rect x="510" y="590" width="8" height="10"></rect>
                <rect x="488" y="640" width="8" height="10"></rect>
                <rect x="522" y="668" width="8" height="10"></rect>
                <rect x="572" y="530" width="6" height="8"></rect>
                <rect x="572" y="580" width="6" height="8"></rect>
                <rect x="620" y="610" width="8" height="10"></rect>
                <rect x="646" y="610" width="8" height="10"></rect>
                <rect x="672" y="640" width="8" height="10"></rect>
                <rect x="620" y="680" width="8" height="10"></rect>
                <rect x="720" y="570" width="7" height="9"></rect>
                <rect x="738" y="600" width="7" height="9"></rect>
                <rect x="720" y="650" width="7" height="9"></rect>
              </g>
              <rect x="0" y="788" width="816" height="150" fill="url(#water)"></rect>
              <g fill="#163844" opacity="0.28">
                <rect x="96" y="800" width="28" height="70"></rect>
                <rect x="258" y="808" width="22" height="80"></rect>
                <rect x="438" y="800" width="24" height="90"></rect>
                <rect x="560" y="812" width="34" height="60"></rect>
              </g>
              <g stroke="#f4e2c8" stroke-width="2" opacity="0.35" fill="none">
                <path d="M20 830H280"></path>
                <path d="M360 860H700"></path>
                <path d="M80 900H420"></path>
              </g>
              <path d="M470 846l34-10 30 10-10 8H480z" fill="#1b3340"></path>
              <path d="M498 836v-22" stroke="#1b3340" stroke-width="2"></path>
              <path d="M-10 930C140 900 240 960 400 930C560 900 680 960 840 940V1488H-10Z" fill="#24543c"></path>
              <path d="M-10 1020C180 980 300 1060 470 1010C640 960 720 1040 840 1000V1488H-10Z" fill="url(#field)"></path>
              <path d="M-10 1140C160 1080 340 1180 520 1120C680 1070 740 1160 840 1120V1488H-10Z" fill="#c6a15a"></path>
              <path d="M-10 1260C200 1200 360 1300 560 1230C700 1180 760 1280 840 1240V1488H-10Z" fill="#4f7a3a"></path>
              <path d="M-10 1360C220 1310 400 1400 620 1340C740 1300 790 1380 840 1360V1488H-10Z" fill="#2f5a34"></path>
              <path d="M250 1040C300 1120 280 1240 340 1360" stroke="#efe6d2" stroke-width="10" fill="none" stroke-linecap="round" opacity="0.8"></path>
              <g>
                <rect x="150" y="1168" width="54" height="40" fill="#f3e6d0"></rect>
                <path d="M140 1170l37-28 37 28" fill="#8c4a38"></path>
                <rect x="170" y="1184" width="14" height="14" fill="#f6c56b"></rect>
              </g>
              <g fill="#1e4634">
                <rect x="118" y="1160" width="6" height="28"></rect>
                <circle cx="121" cy="1148" r="16"></circle>
                <rect x="230" y="1124" width="6" height="30"></rect>
                <circle cx="233" cy="1110" r="18"></circle>
                <rect x="620" y="1088" width="7" height="34"></rect>
                <circle cx="623" cy="1072" r="20"></circle>
                <rect x="700" y="1188" width="6" height="28"></rect>
                <circle cx="703" cy="1174" r="16"></circle>
              </g>
              <rect width="816" height="1488" filter="url(#grain)" opacity="0.18" style="mix-blend-mode: multiply"></rect>
            </svg>
          </div>
        </aside>
      </div>
    </article>
  </main>
</Base>

<script>
  const root = document.querySelector("[data-bio-root]");
  if (root) {
    const buttons = root.querySelectorAll("[data-bio]");
    const panels = root.querySelectorAll("[data-bio-panel]");
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const key = button.getAttribute("data-bio");
        buttons.forEach((item) => {
          item.setAttribute("aria-pressed", String(item === button));
        });
        panels.forEach((panel) => {
          panel.toggleAttribute("hidden", panel.getAttribute("data-bio-panel") !== key);
        });
      });
    });
  }
</script>
