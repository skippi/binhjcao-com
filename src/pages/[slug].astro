---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { formatDate, site } from "../content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.date.toISOString().slice(0, 10);
---

<Base title={entry.data.title} description={entry.data.description} kind="article">
  <main class="site-shell">
    <article class="content-frame is-article">
      <h1 class="content-title">{entry.data.title}</h1>
      <p class="article-meta">
        <a href="/">
          <img class="article-avatar" src={site.avatar} alt="" width="28" height="28" />
          <span class="article-byline">
            <time datetime={date}>{formatDate(entry.data.date)}</time>
            <span aria-hidden="true">·</span>
            {site.name}
          </span>
        </a>
      </p>
      <div class="article-body">
        <Content />
      </div>
    </article>
  </main>
</Base>
